# Give each agent its own long random phrase. NEVER commit the real .env
WEATHER_SEED=change-me-long-random-phrase-1
PLANNER_SEED=change-me-long-random-phrase-2

# Optional: ASI1 key for smarter intent parsing (get it from asi1.ai). Works without it.
ASI1_API_KEY=

# Fill AFTER you first run weather_agent.py (address is printed in its logs)
WEATHER_AGENT_ADDRESS=

# Optional: your College Planner agent's address (enables "when am I free" + auto dates)
COLLEGE_AGENT_ADDRESS=

# College Planner agent seed (any long random text)
COLLEGE_SEED=change-me-long-random-phrase-3
